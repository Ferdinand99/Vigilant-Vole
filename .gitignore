# Rust
/target
**/*.rs.bk

# SQLite data (never commit persisted DB)
/data
*.db
*.db-journal
*.sqlite
# ...except the upgrade-test fixtures (tools/upgrade-fixtures/generate.sh)
!tests/fixtures/upgrade/*/vigilant-vole.db

# Env / secrets
.env
.env.local

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# SQLite WAL side files
*.db-wal
*.db-shm

# Claude Code local state (never publish)
.claude/

# e2e / Playwright artifacts
test-results/
playwright-report/
__pycache__/
.pytest_cache/
*.pyc

# Load test output (reference runs live in docs/performance/)
tools/loadtest/results/

.superpowers/
