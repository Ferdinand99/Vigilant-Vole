# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts run inside Linux containers
*.sh text eol=lf

# SQLite databases (the upgrade-test fixtures) are binary
*.db binary

# Golden test snapshots (tests/golden) are compared byte for byte
*.snap text eol=lf

# The notices and the files they are made from are compared byte for byte (hashes, cmp in CI)
THIRD-PARTY-NOTICES text eol=lf
legal/* text eol=lf
notices-extra.json text eol=lf
about.toml text eol=lf
*.mjs text eol=lf
LICENSE text eol=lf
static/htmx.min.js text eol=lf
static/sse.js text eol=lf
