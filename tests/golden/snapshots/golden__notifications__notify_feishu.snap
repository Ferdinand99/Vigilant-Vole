provider: feishu (Feishu / Lark)

## minimal config
{
  "url": "https://open.feishu.cn/open-apis/bot/v2/hook/"
}

### down
POST https://open.feishu.cn/open-apis/bot/v2/hook/
(json)
{
  "card": {
    "config": {
      "wide_screen_mode": true
    },
    "elements": [
      {
        "tag": "div",
        "text": {
          "content": "HTTP 503 (after 3 retries)\n\nTarget: https://pay.example/health\nType: HTTP(S)\nTime: 2026-10-19 14:03:12 UTC\n\n[View monitor](https://vv.example/monitors/7)",
          "tag": "lark_md"
        }
      },
      {
        "actions": [
          {
            "tag": "button",
            "text": {
              "content": "View monitor",
              "tag": "plain_text"
            },
            "type": "primary",
            "url": "https://vv.example/monitors/7"
          }
        ],
        "tag": "action"
      }
    ],
    "header": {
      "template": "red",
      "title": {
        "content": "🔴 Payments API is down",
        "tag": "plain_text"
      }
    }
  },
  "msg_type": "interactive"
}

