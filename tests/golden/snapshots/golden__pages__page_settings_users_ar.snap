<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f5f5f7">
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b0b0d">
  <meta name="htmx-config" content='{"includeIndicatorStyles": false, "allowEval": false, "allowScriptTags": false}'>
  <title>المستخدمون · Golden Vole</title>
  <link rel="icon" href="/static/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/static/apple-touch-icon.png">
  <link rel="manifest" href="/static/site.webmanifest">
  <meta name="apple-mobile-web-app-title" content="Golden Vole">
  <link rel="preload" href="/static/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/static/style.css">
  <script src="/static/theme.js"></script>
  <script src="/static/htmx.min.js" defer></script>
  <script src="/static/sse.js" defer></script>
  <script src="/static/app.js" defer></script>
  
</head>
<body>
  <a class="skip" href="#main">تخطَّ إلى المحتوى</a>

  <header class="topbar">
    <div class="topbar-inner container">
      <a class="brand" href="/">
        <img src="/static/favicon.svg" alt="" width="28" height="28">
        <span>Golden Vole</span>
      </a>

      <nav class="topnav" aria-label="الرئيسية" hx-boost="true" hx-swap="innerHTML transition:true">
        <a class="topnav-link" href="/">لوحة المعلومات</a>
        <a class="topnav-link" href="/status-pages">صفحات الحالة</a>
        <a class="topnav-link" href="/maintenance">الصيانة</a>
        <a class="topnav-link" href="/settings" aria-current="page">الإعدادات</a>
      </nav>

      <div class="topbar-end">
        <button class="user-button" type="button" popovertarget="user-menu" aria-label="الحساب والمظهر">
          <span class="avatar" aria-hidden="true">A</span>
        </button>
        <div class="menu" id="user-menu" popover>
          <div class="user-card">
            <span class="avatar avatar-lg" aria-hidden="true">A</span>
            <span>
              <span class="user-card-name">admin</span>
              <span class="user-card-meta">admin · مسؤول</span>
            </span>
          </div>
          <hr class="menu-sep">
          <a class="menu-item" href="/settings/security"><svg class="icon" aria-hidden="true"><use href="/static/icons.svg#shield"></use></svg>الأمان</a>
          <a class="menu-item" href="/settings/tokens"><svg class="icon" aria-hidden="true"><use href="/static/icons.svg#key"></use></svg>رموز API</a>
          <a class="menu-item" href="/api-docs"><svg class="icon" aria-hidden="true"><use href="/static/icons.svg#code"></use></svg>وثائق API</a>
          <hr class="menu-sep">
          <p class="menu-label" id="theme-label">المظهر</p>
          <div class="theme-picker">
            <div class="segmented segmented-block" role="radiogroup" aria-labelledby="theme-label">
              <label><input type="radio" name="vv-theme" value="auto" data-theme-set="auto"><svg class="icon" aria-hidden="true"><use href="/static/icons.svg#theme-auto"></use></svg><span>تلقائي</span></label>
              <label><input type="radio" name="vv-theme" value="light" data-theme-set="light"><svg class="icon" aria-hidden="true"><use href="/static/icons.svg#sun"></use></svg><span>فاتح</span></label>
              <label><input type="radio" name="vv-theme" value="dark" data-theme-set="dark"><svg class="icon" aria-hidden="true"><use href="/static/icons.svg#moon"></use></svg><span>داكن</span></label>
            </div>
          </div>
          <hr class="menu-sep">
          <form method="post" action="/logout">
            <button class="menu-item" type="submit"><svg class="icon" aria-hidden="true"><use href="/static/icons.svg#logout"></use></svg>تسجيل الخروج</button>
          </form>
        </div>
      </div>
    </div>
  </header>

  <main id="main" class="main container " tabindex="-1">
    
<div class="settings">
  <aside class="settings-side">
    <p class="settings-heading" aria-hidden="true">الإعدادات</p>
    <nav class="settings-nav" aria-label="الإعدادات" hx-boost="true" hx-swap="innerHTML transition:true">
      <a class="settings-link" href="/settings/general"><svg class="icon" aria-hidden="true"><use href="/static/icons.svg#sliders"></use></svg>عام</a>
      <a class="settings-link" href="/settings/notifications"><svg class="icon" aria-hidden="true"><use href="/static/icons.svg#bell"></use></svg>الإشعارات</a>
      <a class="settings-link" href="/settings/users" aria-current="page"><svg class="icon" aria-hidden="true"><use href="/static/icons.svg#users"></use></svg>المستخدمون</a>
      <a class="settings-link" href="/settings/security"><svg class="icon" aria-hidden="true"><use href="/static/icons.svg#shield"></use></svg>الأمان</a>
      <a class="settings-link" href="/settings/tokens"><svg class="icon" aria-hidden="true"><use href="/static/icons.svg#key"></use></svg>رموز API</a>
      <a class="settings-link" href="/settings/agents"><svg class="icon" aria-hidden="true"><use href="/static/icons.svg#server"></use></svg>الوكلاء البعيدون</a>
      <a class="settings-link" href="/settings/integrations"><svg class="icon" aria-hidden="true"><use href="/static/icons.svg#plug"></use></svg>التكاملات</a>
      <a class="settings-link" href="/settings/browsers"><svg class="icon" aria-hidden="true"><use href="/static/icons.svg#browser"></use></svg>المتصفحات البعيدة</a>
      <a class="settings-link" href="/settings/backup"><svg class="icon" aria-hidden="true"><use href="/static/icons.svg#archive"></use></svg>النسخ الاحتياطي</a>
    </nav>
  </aside>
  <div class="settings-content" id="settings-content">
    
<header class="page-head">
  <div class="page-head-row">
    <div class="page-head-text">
      <h1 class="page-title">المستخدمون</h1>
      <p class="page-sub">من يمكنه تسجيل الدخول وما الذي يمكنه تغييره.</p>
    </div>
    <div class="page-actions">
  <button type="button" class="btn btn-primary" data-sheet-open="#new-user" commandfor="new-user" command="show-modal"><svg class="icon" aria-hidden="true"><use href="/static/icons.svg#plus"></use></svg><span>مستخدم جديد</span></button>
</div>
  </div>
</header>

<section class="section" aria-labelledby="users-title">
  <div class="section-head">
  <div>
    <h2 class="section-title" id="users-title">الأشخاص</h2>
  </div>
  <div class="toolbar"></div>
</div>
  <ul class="list" role="list">
    <li class="list-row" id="user-1">
  <span class="avatar" aria-hidden="true">A</span>
  <span class="list-main">
    <span class="list-title">admin <span class="muted">(أنت)</span></span>
    <span class="list-sub">admin · آخر تسجيل دخول <time datetime="<DATETIME>" data-relative title="<DATETIME>"><DATETIME></time></span>
  </span>
  <span class="list-trail cluster">
    <span class="badge badge-brand">مسؤول</span>
    <button type="button" class="btn btn-icon btn-plain btn-sm" popovertarget="user-menu-1" aria-label="إجراءات admin"><svg class="icon" aria-hidden="true"><use href="/static/icons.svg#more"></use></svg></button>
  </span>
  <div class="menu" id="user-menu-1" popover>
    <button class="menu-item" type="button" data-sheet-open="#edit-user-1" commandfor="edit-user-1" command="show-modal"><svg class="icon" aria-hidden="true"><use href="/static/icons.svg#pencil"></use></svg>تعديل</button>
  </div>
</li>
  </ul>
  <p class="section-foot">المشاهدون يستطيعون الاطلاع دون تغيير أي شيء. المحررون يديرون المراقبات وصفحات الحالة والصيانة والإشعارات. المسؤولون يستطيعون كل شيء، بما فيه المستخدمون والإعدادات.</p>
</section>

<dialog class="sheet" id="new-user" aria-labelledby="new-user-title">
  <div class="sheet-grabber" aria-hidden="true"></div>
  <header class="sheet-head">
    <h2 class="sheet-title" id="new-user-title">مستخدم جديد</h2>
    <button type="button" class="btn btn-icon btn-plain btn-sm" data-sheet-close commandfor="new-user" command="close" aria-label="إغلاق"><svg class="icon" aria-hidden="true"><use href="/static/icons.svg#x"></use></svg></button>
  </header>
  <div class="sheet-body">
    <form id="new-user-form" class="form" method="post" action="/settings/users">
      <div class="field-row">
        <div class="field">
          <label class="label" for="nu-username">اسم المستخدم</label>
          <input id="nu-username" name="username" type="text" required maxlength="64" autocomplete="off" autocapitalize="none" spellcheck="false" placeholder="ada…">
        </div>
        <div class="field">
          <label class="label" for="nu-display">الاسم المعروض <span class="label-optional">اختياري</span></label>
          <input id="nu-display" name="display_name" type="text" maxlength="80" autocomplete="off" placeholder="Ada Lovelace…">
        </div>
      </div>
      <div class="field">
        <span class="label" id="nu-role-label">الدور</span>
        <div class="segmented segmented-block" role="radiogroup" aria-labelledby="nu-role-label">
          <label><input type="radio" name="role" value="viewer" checked><span>مشاهد</span></label>
          <label><input type="radio" name="role" value="editor"><span>محرر</span></label>
          <label><input type="radio" name="role" value="admin"><span>مسؤول</span></label>
        </div>
      </div>
      <div class="field">
        <label class="label" for="nu-password">كلمة مرور مؤقتة</label>
        <input id="nu-password" name="password" type="text" required minlength="10" maxlength="1024" autocomplete="off" autocapitalize="none" spellcheck="false" class="mono" aria-describedby="nu-password-help">
        <p class="help" id="nu-password-help">10 أحرف على الأقل. شاركها بسرية؛ يمكنه تغييرها من الأمان.</p>
      </div>
    </form>
  </div>
  <footer class="sheet-foot">
    <button type="button" class="btn btn-secondary" data-sheet-close commandfor="new-user" command="close">إلغاء</button>
    <button type="submit" class="btn btn-primary" form="new-user-form">إضافة مستخدم</button>
  </footer>
</dialog>
<dialog class="sheet" id="edit-user-1" aria-labelledby="edit-user-1-title">
  <div class="sheet-grabber" aria-hidden="true"></div>
  <header class="sheet-head">
    <h2 class="sheet-title" id="edit-user-1-title">تعديل admin</h2>
    <button type="button" class="btn btn-icon btn-plain btn-sm" data-sheet-close commandfor="edit-user-1" command="close" aria-label="إغلاق"><svg class="icon" aria-hidden="true"><use href="/static/icons.svg#x"></use></svg></button>
  </header>
  <div class="sheet-body">
    <form id="edit-user-1-form" class="form" method="post" action="/settings/users/1">
      <div class="field">
        <label class="label" for="eu-1-display">الاسم المعروض <span class="label-optional">اختياري</span></label>
        <input id="eu-1-display" name="display_name" type="text" maxlength="80" autocomplete="off" value="" placeholder="admin…">
      </div>
      <input type="hidden" name="role" value="admin">
      <p class="help">دورك هو مسؤول. يمكن لمسؤول آخر تغييره.</p>
    </form>
  </div>
  <footer class="sheet-foot">
    <button type="button" class="btn btn-secondary" data-sheet-close commandfor="edit-user-1" command="close">إلغاء</button>
    <button type="submit" class="btn btn-primary" form="edit-user-1-form">حفظ المستخدم</button>
  </footer>
</dialog>

  </div>
</div>

  </main>

  <footer class="app-foot container">
    Vigilant Vole <a href="https://github.com/Ferdinand99/Vigilant-Vole/releases/tag/v<VERSION>"><VERSION></a>
  </footer>

  <nav class="tabbar" aria-label="الرئيسية" hx-boost="true" hx-swap="innerHTML transition:true">
    <a class="tabbar-item" href="/"><svg class="icon" aria-hidden="true"><use href="/static/icons.svg#pulse"></use></svg><span>لوحة المعلومات</span></a>
    <a class="tabbar-item" href="/status-pages"><svg class="icon" aria-hidden="true"><use href="/static/icons.svg#globe"></use></svg><span>الحالة</span></a>
    <a class="tabbar-item" href="/maintenance"><svg class="icon" aria-hidden="true"><use href="/static/icons.svg#wrench"></use></svg><span>الصيانة</span></a>
    <a class="tabbar-item" href="/settings" aria-current="page"><svg class="icon" aria-hidden="true"><use href="/static/icons.svg#gear"></use></svg><span>الإعدادات</span></a>
  </nav>

  <div class="toaster" id="toaster" aria-live="polite">
  </div>
  <div class="progress-bar" id="vv-progress" aria-hidden="true"></div>
  <script type="application/json" id="vv-i18n">{"ai_copied":"نُسخ مرجع API. الصقه في مساعد الذكاء الاصطناعي.","ai_downloaded":"تعذّر النسخ، لذا نُزّل المرجع كملف Markdown.","ai_failed":"تعذّر تحميل مرجع API. حاول مرة أخرى.","cancel":"إلغاء","confirm":"تأكيد","confirm_title":"هل أنت متأكد؟","connecting":"جارٍ الاتصال…","copied":"تم النسخ","copied_announce":"تم النسخ إلى الحافظة","copy_failed":"تعذّر النسخ. حدّد النص وانسخه يدويًا.","delete":"حذف","dismiss":"تجاهل","hint_common":"تجنّب الكلمات والتسلسلات الشائعة","hint_min_length":"استخدم {n} أحرف على الأقل","hint_repeated":"أحرف مكررة كثيرًا","live":"مباشر","moved":"تم نقل {item} إلى الموضع {pos} من {total}","network_error":"تعذّر الوصول إلى الخادم. تحقق من اتصالك.","offline":"غير متصل","reconnecting":"جارٍ إعادة الاتصال…","server_error":"حدث خطأ في الخادم. حاول مرة أخرى.","strength_0":"قصيرة جدًا","strength_1":"ضعيفة","strength_2":"مقبولة","strength_3":"جيدة","strength_4":"قوية","strength_prefix":"القوة:"}</script>
  
</body>
</html>
