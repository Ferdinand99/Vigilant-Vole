              <pre class="code"><code>{&#34;ok&#34;: true, &#34;product&#34;: &#34;HeadlessChrome/156.0.8078.36&#34;, &#34;protocol_version&#34;: &#34;1.3&#34;}</code></pre>
            </div>
          </details>
        </div>
      </li>
    </ul>
  </div>
</section>
<section class="section" id="status-pages" aria-labelledby="status-pages-title">
