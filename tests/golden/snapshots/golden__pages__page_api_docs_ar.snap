            </div>
          </details>
        </div>
      </li>
      <li class="list-row list-row-wrap" id="delete--api-v1-remote-browsers-id">
        <span class="list-main">
          <span class="list-title"><span class="badge mono">DELETE</span> <code class="break">/api/v1/remote-browsers/{id}</code></span>
          <span class="list-sub">Remove a remote browser; monitors that used it fall back to the default one.</span>
        </span>
        <span class="list-trail"><span class="badge status-down">admin</span></span>
      </li>
      <li class="list-row list-row-wrap" id="post--api-v1-remote-browsers-id-test">
