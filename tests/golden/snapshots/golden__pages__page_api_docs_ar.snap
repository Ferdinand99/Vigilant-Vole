          <span class="list-title"><span class="badge mono">POST</span> <code class="break">/api/v1/monitors/{id}/pause</code></span>
          <span class="list-sub">Pause checks and alerts.</span>
        </span>
        <span class="list-trail"><span class="badge status-pending">editor</span></span>
