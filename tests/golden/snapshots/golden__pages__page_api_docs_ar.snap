              <p class="t-footnote muted">الاستجابة</p>
              <pre class="code"><code>{&#34;data&#34;: [{&#34;id&#34;: 1, &#34;name&#34;: &#34;Chrome&#34;, &#34;url&#34;: &#34;ws://chrome:9222/devtools/browser/…&#34;, &#34;monitors&#34;: 3, &#34;default&#34;: true}], &#34;next_cursor&#34;: null}</code></pre>
            </div>
          </details>
        </div>
      </li>
      <li class="list-row list-row-wrap" id="post--api-v1-remote-browsers">
        <span class="list-main">
          <span class="list-title"><span class="badge mono">POST</span> <code class="break">/api/v1/remote-browsers</code></span>
          <span class="list-sub">Add a remote browser: ws(s)://…/devtools/browser/&#60;id&#62;, http(s)://host:port (discovered through /json/version) or wss://host?token=….</span>
        </span>
        <span class="list-trail"><span class="badge status-down">admin</span></span>
        <div class="list-full">
          <details class="disclosure">
            <summary>التفاصيل <span class="disclosure-sub">أمثلة</span><svg class="icon" aria-hidden="true"><use href="/static/icons.svg#chevron-down"></use></svg></summary>
            <div class="disclosure-body stack-sm">
              <p class="t-footnote muted">الطلب</p>
              <pre class="code"><code>{&#34;name&#34;: &#34;Chrome&#34;, &#34;url&#34;: &#34;http://chrome:9222&#34;}</code></pre>
            </div>
          </details>
        </div>
      </li>
      <li class="list-row list-row-wrap" id="get--api-v1-remote-browsers-id">
        <span class="list-main">
          <span class="list-title"><span class="badge mono">GET</span> <code class="break">/api/v1/remote-browsers/{id}</code></span>
          <span class="list-sub">Get one remote browser (secrets masked).</span>
        </span>
        <span class="list-trail"><span class="badge status-up">viewer</span></span>
      </li>
      <li class="list-row list-row-wrap" id="put--api-v1-remote-browsers-id">
        <span class="list-main">
          <span class="list-title"><span class="badge mono">PUT</span> <code class="break">/api/v1/remote-browsers/{id}</code></span>
          <span class="list-sub">Change a remote browser. A masked URL keeps its token while the host stays the same.</span>
        </span>
        <span class="list-trail"><span class="badge status-down">admin</span></span>
      </li>
      <li class="list-row list-row-wrap" id="patch--api-v1-remote-browsers-id">
        <span class="list-main">
          <span class="list-title"><span class="badge mono">PATCH</span> <code class="break">/api/v1/remote-browsers/{id}</code></span>
          <span class="list-sub">Rename a remote browser or change its URL.</span>
        </span>
        <span class="list-trail"><span class="badge status-down">admin</span></span>
        <div class="list-full">
          <details class="disclosure">
