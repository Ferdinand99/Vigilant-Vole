        </div>
      </li>
      <li class="list-row list-row-wrap" id="delete--api-v1-status-pages-id-incidents-iid">
        <span class="list-main">
          <span class="list-title"><span class="badge mono">DELETE</span> <code class="break">/api/v1/status-pages/{id}/incidents/{iid}</code></span>
          <span class="list-sub">Delete an incident.</span>
        </span>
        <span class="list-trail"><span class="badge status-pending">editor</span></span>
