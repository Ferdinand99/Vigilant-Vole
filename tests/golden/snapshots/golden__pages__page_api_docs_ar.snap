<section class="section" id="remote-browsers" aria-labelledby="remote-browsers-title">
  <div class="section-head">
  <div>
    <h2 class="section-title" id="remote-browsers-title">Remote browsers</h2>
  </div>
  <div class="toolbar"></div>
</div>
  <div class="card card-flush">
    <ul class="list" role="list">
      <li class="list-row list-row-wrap" id="get--api-v1-remote-browsers">
        <span class="list-main">
          <span class="list-title"><span class="badge mono">GET</span> <code class="break">/api/v1/remote-browsers</code></span>
          <span class="list-sub">List the remote browsers (CDP endpoints) real-browser monitors use. Tokens and passwords in URLs are masked; the first one is the default.</span>
        </span>
        <span class="list-trail"><span class="badge status-up">viewer</span></span>
        <div class="list-full">
          <details class="disclosure">
            <summary>التفاصيل <span class="disclosure-sub">أمثلة</span><svg class="icon" aria-hidden="true"><use href="/static/icons.svg#chevron-down"></use></svg></summary>
