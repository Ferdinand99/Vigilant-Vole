      <li class="list-row list-row-wrap" id="post--api-v1-monitors-id-check">
        <span class="list-main">
          <span class="list-title"><span class="badge mono">POST</span> <code class="break">/api/v1/monitors/{id}/check</code></span>
          <span class="list-sub">Run a check right now and return its result (409 for paused, push, group and agent-checked monitors).</span>
        </span>
        <span class="list-trail"><span class="badge status-pending">editor</span></span>
        <div class="list-full">
          <details class="disclosure">
            <summary>التفاصيل <span class="disclosure-sub">أمثلة</span><svg class="icon" aria-hidden="true"><use href="/static/icons.svg#chevron-down"></use></svg></summary>
            <div class="disclosure-body stack-sm">
              <p class="t-footnote muted">الاستجابة</p>
              <pre class="code"><code>{&#34;status&#34;: &#34;up&#34;, &#34;heartbeat&#34;: {&#34;id&#34;: 991, &#34;status&#34;: &#34;up&#34;, &#34;raw_status&#34;: &#34;up&#34;, &#34;response_time_ms&#34;: 84, &#34;message&#34;: &#34;200 OK&#34;, &#34;checked_at&#34;: &#34;<DATETIME>&#34;}}</code></pre>
            </div>
          </details>
        </div>
      </li>
      <li class="list-row list-row-wrap" id="get--api-v1-monitors-id-heartbeats">
        <span class="list-main">
          <span class="list-title"><span class="badge mono">GET</span> <code class="break">/api/v1/monitors/{id}/heartbeats</code></span>
          <span class="list-sub">Check history, newest first (local checks only). During maintenance status is maintenance and raw_status is what the check found (up, down or pending); otherwise they are equal. raw_status is null for checks recorded during maintenance by older versions.</span>
        </span>
        <span class="list-trail"><span class="badge status-up">viewer</span></span>
        <div class="list-full">
          <details class="disclosure">
            <summary>التفاصيل <span class="disclosure-sub">المعاملات, أمثلة</span><svg class="icon" aria-hidden="true"><use href="/static/icons.svg#chevron-down"></use></svg></summary>
            <div class="disclosure-body stack-sm">
              <dl class="dl">
                <div class="dl-row"><dt><code>since</code></dt><dd>UTC time, e.g. <DATETIME></dd></div>
                <div class="dl-row"><dt><code>limit</code></dt><dd>page size (1–500, default 50)</dd></div>
                <div class="dl-row"><dt><code>cursor</code></dt><dd>next_cursor from the previous page</dd></div>
              </dl>
              <p class="t-footnote muted">الاستجابة</p>
              <pre class="code"><code>{&#34;data&#34;: [{&#34;id&#34;: 991, &#34;monitor_id&#34;: 7, &#34;agent_id&#34;: null, &#34;status&#34;: &#34;maintenance&#34;, &#34;raw_status&#34;: &#34;up&#34;, &#34;response_time_ms&#34;: 84, &#34;message&#34;: &#34;200 OK&#34;, &#34;checked_at&#34;: &#34;<DATETIME>&#34;}], &#34;next_cursor&#34;: &#34;940&#34;}</code></pre>
            </div>
          </details>
        </div>
      </li>
      <li class="list-row list-row-wrap" id="get--api-v1-monitors-id-uptime">
        <span class="list-main">
          <span class="list-title"><span class="badge mono">GET</span> <code class="break">/api/v1/monitors/{id}/uptime</code></span>
          <span class="list-sub">Uptime over a window plus one entry per day (survives heartbeat retention).</span>
        </span>
        <span class="list-trail"><span class="badge status-up">viewer</span></span>
        <div class="list-full">
          <details class="disclosure">
            <summary>التفاصيل <span class="disclosure-sub">المعاملات, أمثلة</span><svg class="icon" aria-hidden="true"><use href="/static/icons.svg#chevron-down"></use></svg></summary>
            <div class="disclosure-body stack-sm">
              <dl class="dl">
                <div class="dl-row"><dt><code>days</code></dt><dd>1–365 (default 30)</dd></div>
              </dl>
              <p class="t-footnote muted">الاستجابة</p>
              <pre class="code"><code>{&#34;monitor_id&#34;: 7, &#34;days&#34;: 30, &#34;uptime_pct&#34;: 99.98, &#34;uptime_24h_pct&#34;: 100.0, &#34;daily&#34;: [{&#34;day&#34;: &#34;<DATE>&#34;, &#34;up&#34;: 1440, &#34;down&#34;: 0, &#34;pending&#34;: 0, &#34;maintenance&#34;: 0, &#34;avg_ms&#34;: 82.4, &#34;uptime_pct&#34;: 100.0}]}</code></pre>
            </div>
          </details>
        </div>
      </li>
      <li class="list-row list-row-wrap" id="get--api-v1-monitors-id-events">
        <span class="list-main">
          <span class="list-title"><span class="badge mono">GET</span> <code class="break">/api/v1/monitors/{id}/events</code></span>
          <span class="list-sub">Outages, maintenance, pauses and other events, newest first.</span>
        </span>
        <span class="list-trail"><span class="badge status-up">viewer</span></span>
        <div class="list-full">
          <details class="disclosure">
            <summary>التفاصيل <span class="disclosure-sub">المعاملات, أمثلة</span><svg class="icon" aria-hidden="true"><use href="/static/icons.svg#chevron-down"></use></svg></summary>
            <div class="disclosure-body stack-sm">
              <dl class="dl">
                <div class="dl-row"><dt><code>limit</code></dt><dd>page size (1–500, default 50)</dd></div>
              </dl>
              <p class="t-footnote muted">الاستجابة</p>
              <pre class="code"><code>{&#34;data&#34;: [{&#34;id&#34;: 12, &#34;monitor_id&#34;: 7, &#34;kind&#34;: &#34;down&#34;, &#34;message&#34;: &#34;timeout&#34;, &#34;started_at&#34;: &#34;<DATETIME>&#34;, &#34;ended_at&#34;: &#34;<DATETIME>&#34;, &#34;duration_seconds&#34;: 240}], &#34;next_cursor&#34;: null}</code></pre>
            </div>
          </details>
        </div>
      </li>
      <li class="list-row list-row-wrap" id="put--api-v1-monitors-id-tags">
        <span class="list-main">
          <span class="list-title"><span class="badge mono">PUT</span> <code class="break">/api/v1/monitors/{id}/tags</code></span>
          <span class="list-sub">Replace a monitor&#39;s tags (names are created if new).</span>
        </span>
        <span class="list-trail"><span class="badge status-pending">editor</span></span>
        <div class="list-full">
          <details class="disclosure">
            <summary>التفاصيل <span class="disclosure-sub">أمثلة</span><svg class="icon" aria-hidden="true"><use href="/static/icons.svg#chevron-down"></use></svg></summary>
            <div class="disclosure-body stack-sm">
