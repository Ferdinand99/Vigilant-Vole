(json)
{
  "body": "down for 12m 4s\nTarget: https://pay.example/health\nType: HTTP(S)\nDowntime: 12m 4s\nTime: 2026-10-19 14:03:12 UTC\nhttps://vv.example/monitors/7",
  "device_key": "secret-device_key",
  "group": "Vigilant Vole",
  "level": "active",
  "title": "🟢 Payments API is back up",
  "url": "https://vv.example/monitors/7"
}

