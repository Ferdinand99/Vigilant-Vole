        ],
        "x-access": "admin"
      }
    },
    "/api/v1/config": {
      "get": {
        "operationId": "get--api-v1-config",
        "parameters": [
          {
            "description": "yaml (default) | json",
            "in": "query",
            "name": "format",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "1 to include secrets (admins only)",
            "in": "query",
            "name": "secrets",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "1 to download as a file",
            "in": "query",
            "name": "download",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/yaml": {
                "example": "version: 1\ntags:\n  - name: production\n    color: green\nnotification_channels:\n  - name: Ops Discord\n    kind: discord\n    config:\n      url: \"••••••\"\nmonitors:\n  - name: Website\n    monitor_type: http\n    target: https://example.com\n    interval_seconds: 30\n    tags: [production]\n    notifications: [Ops Discord]\nstatus_pages:\n  - slug: acme\n    title: Acme status\n    sections:\n      - name: Services\n        monitors: [Website]"
              }
            },
            "description": "Success"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "sessionCookie": []
          }
        ],
        "summary": "Export the whole configuration as YAML or JSON. Secrets are masked unless an admin asks for them.",
        "tags": [
          "Configuration"
        ],
        "x-access": "editor"
      },
      "post": {
        "operationId": "post--api-v1-config",
        "parameters": [
          {
            "description": "merge (default) | replace",
            "in": "query",
            "name": "mode",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "1 to only return the plan",
            "in": "query",
            "name": "dry_run",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "1, required to apply a replace",
            "in": "query",
            "name": "confirm",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            },
            "application/yaml": {
              "example": "version: 1\ntags:\n  - name: production\n    color: green\nnotification_channels:\n  - name: Ops Discord\n    kind: discord\n    config:\n      url: \"••••••\"\nmonitors:\n  - name: Website\n    monitor_type: http\n    target: https://example.com\n    interval_seconds: 30\n    tags: [production]\n    notifications: [Ops Discord]\nstatus_pages:\n  - slug: acme\n    title: Acme status\n    sections:\n      - name: Services\n        monitors: [Website]",
              "schema": {
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "applied": false,
                  "errors": [],
                  "items": [
                    {
                      "action": "update",
                      "changes": [
                        "interval_seconds"
                      ],
                      "key": "Website",
                      "kind": "monitor"
                    },
                    {
                      "action": "create",
                      "key": "staging",
                      "kind": "tag"
                    }
                  ],
                  "mode": "merge",
                  "summary": {
                    "create": 2,
                    "delete": 0,
                    "skip": 0,
                    "unchanged": 14,
                    "update": 1
                  },
                  "warnings": []
                }
              }
            },
            "description": "Success"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "sessionCookie": []
          }
        ],
        "summary": "Import a configuration document (YAML or JSON body). Merge upserts by key; replace also deletes what the document doesn't list in the sections it contains. Masked secrets keep stored values.",
        "tags": [
          "Configuration"
        ],
        "x-access": "admin"
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "get--api-v1-health",
