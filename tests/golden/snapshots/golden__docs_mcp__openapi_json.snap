          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "sessionCookie": []
          }
        ],
        "summary": "Version, uptime and monitor counts.",
        "tags": [
          "System"
        ],
        "x-access": "viewer"
      }
    },
    "/api/v1/maintenance": {
      "get": {
        "operationId": "get--api-v1-maintenance",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "sessionCookie": []
          }
        ],
        "summary": "List maintenance windows with their current state.",
        "tags": [
          "Maintenance"
        ],
        "x-access": "viewer"
      },
      "post": {
        "operationId": "post--api-v1-maintenance",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "monitor_ids": [
                  7
                ],
                "strategy": "weekly",
                "time_from": "22:00",
                "time_to": "23:30",
                "timezone": "Europe/Oslo",
                "title": "Database upgrade",
                "weekdays": "2,4"
              },
              "schema": {}
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Success"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "sessionCookie": []
          }
        ],
        "summary": "Create a window. Times: start_at/end_at in UTC, time_from/time_to local to timezone, weekdays ISO (1 = Monday). Strategies: manual, once, daily, weekly, interval (interval_days, counted from start_at), monthly (month_days like 1,15,-1) and cron (cron + duration_minutes).",
        "tags": [
          "Maintenance"
        ],
        "x-access": "editor"
      }
    },
