    "/api/v1/monitors": {
      "get": {
        "operationId": "get--api-v1-monitors",
        "parameters": [
          {
            "description": "up | down | pending | maintenance | paused | unknown",
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "monitor type, e.g. http",
            "in": "query",
            "name": "type",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "tag name",
            "in": "query",
            "name": "tag",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "search name, target and description",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "page size (1–500, default 50)",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "next_cursor from the previous page",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": "{\"data\": [ …monitor… ], \"next_cursor\": \"42\"}"
              }
            },
            "description": "Success"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "sessionCookie": []
          }
        ],
        "summary": "List monitors with their current status. status is what status pages show (maintenance during a window); maintenance says whether a window covers the monitor now; raw_status (up, down, pending or null), raw_status_since (RFC 3339) and raw_message are the real check result, which keeps coming in during maintenance. raw_* are null for paused monitors.",
        "tags": [
          "Monitors"
        ],
        "x-access": "viewer"
      },
      "post": {
        "operationId": "post--api-v1-monitors",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "escalation_minutes": 15,
                "interval_seconds": 60,
                "monitor_type": "http",
                "name": "Website",
                "notifications": [
                  1,
                  {
                    "channel_id": 3,
                    "escalation": true
                  }
                ],
                "retries": 1,
                "tags": [
                  "production",
                  {
                    "name": "env",
                    "value": "prod"
                  }
                ],
                "target": "https://example.com"
              },
              "schema": {}
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "example": {
                  "accepted_status_codes": "200-399",
                  "active": true,
                  "created_at": "2026-10-19 08:00:00",
                  "description": "",
                  "expiry_days": 14,
                  "expiry_notify": true,
                  "http_method": "GET",
                  "id": 7,
                  "ignore_tls": false,
                  "interval_seconds": 60,
                  "maintenance": false,
                  "max_redirects": 10,
                  "monitor_type": "http",
                  "name": "Website",
                  "notifications": [
                    {
                      "channel_id": 1,
                      "escalation": false
                    }
                  ],
                  "parent_id": null,
                  "raw_message": "200 OK",
                  "raw_status": "up",
                  "raw_status_since": "2026-10-19T14:01:00Z",
                  "retries": 1,
                  "retry_interval_seconds": null,
                  "status": "up",
                  "tags": [
                    {
                      "color": "green",
                      "id": 2,
                      "name": "production",
                      "value": ""
                    }
                  ],
                  "target": "https://example.com",
                  "timeout_seconds": 10,
                  "updated_at": "2026-10-19 08:00:00",
                  "upside_down": false
                }
              }
            },
            "description": "Success"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "sessionCookie": []
          }
        ],
        "summary": "Create a monitor. Same validation as the monitor form; unknown tag names are created.",
        "tags": [
          "Monitors"
        ],
        "x-access": "editor"
      }
    },
    "/api/v1/monitors/bulk": {
      "post": {
        "operationId": "post--api-v1-monitors-bulk",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "filter": {
                  "tag": "production",
                  "type": "http"
                },
                "set": {
                  "channels": {
                    "add": [
