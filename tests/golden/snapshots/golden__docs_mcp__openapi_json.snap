---
source: tests/golden/docs_mcp.rs
expression: "format!(\"content-type: {}\\n\\n{}\", res.header(\"content-type\"), pretty(&doc))"
---
content-type: application/json

{
  "components": {
    "responses": {
      "Error": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "code": "validation_failed",
                "fields": {
                  "target": "Enter a full URL, including https://, like https://example.com."
                },
                "message": "Enter a full URL, including https://, like https://example.com."
              }
            }
          }
        },
        "description": "Error"
      }
    },
    "securitySchemes": {
      "agentToken": {
        "description": "Remote agent token (vva_…)",
        "scheme": "bearer",
        "type": "http"
      },
      "bearerAuth": {
        "description": "API token (vv_…)",
        "scheme": "bearer",
        "type": "http"
      },
      "sessionCookie": {
        "in": "cookie",
        "name": "vv_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "REST API for Vigilant Vole. Authenticate with `Authorization: Bearer vv_…` (create tokens under Settings → API tokens). Read-only tokens act as viewers. Errors use `{\"error\": {\"code\", \"message\", \"fields\"}}`; lists use `?limit=&cursor=` and return `next_cursor`.",
    "title": "Vigilant Vole API",
    "version": "<VERSION>"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/agent/v1/monitors": {
      "get": {
        "operationId": "get--api-agent-v1-monitors",
        "responses": {
          "200": {
            "description": "Success"
          }
        },
        "security": [
          {
            "agentToken": []
          }
        ],
        "summary": "For remote agents: the monitors to run (Bearer vva_… token, ETag).",
        "tags": [
          "Push and machine endpoints"
        ],
        "x-access": "agent token"
      }
    },
    "/api/agent/v1/results": {
      "post": {
        "operationId": "post--api-agent-v1-results",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "results": [
                  {
                    "checked_at": "2026-10-19 14:03:00",
                    "message": "200 OK",
                    "monitor_id": 7,
                    "response_time_ms": 120,
                    "status": "up"
                  }
                ]
              },
              "schema": {}
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "agentToken": []
          }
        ],
        "summary": "For remote agents: a batch of up to 500 results.",
        "tags": [
          "Push and machine endpoints"
        ],
        "x-access": "agent token"
      }
    },
    "/api/badge/{id}/{kind}": {
      "get": {
        "operationId": "get--api-badge-id-kind",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "kind",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "24h | 7d | 30d",
            "in": "query",
            "name": "duration",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "flat | flat-square",
            "in": "query",
            "name": "style",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "custom label",
            "in": "query",
            "name": "label",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [],
        "summary": "SVG badge: kind is status, uptime, ping or cert-exp. Public when the monitor is on a published status page or badges are public.",
        "tags": [
          "Push and machine endpoints"
        ],
        "x-access": "public"
      }
    },
    "/api/push/{token}": {
      "get": {
        "operationId": "get--api-push-token",
        "parameters": [
          {
            "in": "path",
            "name": "token",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "up (default) | down",
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "message to record",
            "in": "query",
            "name": "msg",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "response time in ms",
            "in": "query",
            "name": "ping",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "ok": true
                }
              }
            },
            "description": "Success"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [],
        "summary": "Report a push monitor's status (POST works too). Rate limited to 1 per second.",
        "tags": [
          "Push and machine endpoints"
        ],
        "x-access": "push token"
      }
    },
    "/api/status-page/{slug}": {
      "get": {
        "operationId": "get--api-status-page-slug",
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": "{\"title\": \"Acme status\", \"overall\": {\"indicator\": \"operational\", \"title\": \"All systems operational\"}, \"sections\": [ … ], \"incidents\": [ … ]}"
              }
            },
            "description": "Success"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [],
        "summary": "A published status page as JSON (CORS enabled), for embedding.",
        "tags": [
          "Push and machine endpoints"
        ],
        "x-access": "public"
      }
    },
    "/api/v1/agents": {
      "get": {
        "operationId": "get--api-v1-agents",
        "responses": {
          "200": {
